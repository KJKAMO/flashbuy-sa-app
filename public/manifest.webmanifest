:root {
  --bg: #0a0a0a;
  --bg-soft: #151515;
  --panel: #1c1c1c;
  --panel-alt: #111111;
  --text: #f5f5f5;
  --muted: #b3b3b3;
  --yellow: #facc15;
  --yellow-strong: #f59e0b;
  --line: rgba(255, 255, 255, 0.1);
  --shadow: 0 20px 40px rgba(0, 0, 0, 0.24);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, 'Segoe UI', sans-serif;
  background: var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

img {
  max-width: 100%;
}

.container {
  width: min(1180px, calc(100vw - 32px));
  margin: 0 auto;
}

.header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(10, 10, 10, 0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}

.nav-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76px;
  gap: 18px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 1.1rem;
  font-weight: 700;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--yellow), var(--yellow-strong));
  color: #0a0a0a;
  font-weight: 800;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 18px;
  color: var(--muted);
}

.main-nav a.active,
.main-nav a:hover {
  color: var(--text);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.primary-button,
.secondary-button,
.icon-button,
.filter-chip,
.text-button,
.product-footer button,
.drawer-header button {
  border: none;
  cursor: pointer;
  transition: 0.2s ease;
}

.primary-button,
.secondary-button,
.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 18px;
  border-radius: 12px;
  font-weight: 600;
}

.primary-button {
  background: linear-gradient(135deg, var(--yellow), var(--yellow-strong));
  color: #111111;
}

.primary-button:hover,
.secondary-button:hover,
.icon-button:hover {
  transform: translateY(-1px);
}

.secondary-button {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
}

.icon-button {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text);
}

.icon-button span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  height: 22px;
  padding: 0 5px;
  border-radius: 999px;
  background: var(--yellow);
  color: #111111;
  font-size: 0.75rem;
  margin-left: 8px;
}

.user-pill {
  color: var(--muted);
  font-size: 0.9rem;
}

.hero {
  position: relative;
  padding: 56px 0 24px;
  background: radial-gradient(circle at top left, rgba(250, 204, 21, 0.22), transparent 30%), #0a0a0a;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 32px;
  align-items: center;
}

.eyebrow {
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--yellow);
  font-size: 0.72rem;
  font-weight: 700;
}

.hero h1,
.catalog-header h1,
.product-info h1,
.auth-card h1,
.checkout-card h1,
.account-summary h1,
.admin-shell h1 {
  margin: 8px 0 14px;
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1.05;
}

.hero-copy,
.product-info p,
.empty-state p,
.card-box p,
.account-summary p,
.order-row p,
.product-body p,
.product-meta {
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 22px;
}

.hero-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 32px;
  padding: 0;
  margin: 26px 0 0;
  list-style: none;
  color: var(--muted);
}

.hero-stats strong {
  display: block;
  color: var(--text);
  font-size: 1.2rem;
}

.hero-card {
  background: linear-gradient(180deg, #181818 0%, #111111 100%);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 28px;
  box-shadow: var(--shadow);
}

.card-badge {
  display: inline-block;
  padding: 8px 10px;
  border-radius: 999px;
  background: rgba(250, 204, 21, 0.2);
  color: var(--yellow);
  font-size: 0.75rem;
  margin-bottom: 18px;
}

.price-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 1.4rem;
  margin: 18px 0 24px;
}

.price-line strong {
  color: var(--yellow);
  font-size: 0.9rem;
}

.sections {
  padding: 40px 0;
}

.alt-bg {
  background: #111111;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(1.5rem, 2vw, 2rem);
}

.section-heading a {
  color: var(--yellow);
}

.category-grid,
.product-grid {
  display: grid;
  gap: 20px;
}

.category-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.category-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120px;
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
  border: 1px solid var(--line);
  border-radius: 22px;
  font-weight: 700;
}

.product-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.product-card {
  background: #111111;
  border: 1px solid var(--line);
  border-radius: 22px;
  overflow: hidden;
}

.product-image-wrap {
  display: block;
}

.product-image {
  display: block;
  width: 100%;
  height: 240px;
  object-fit: cover;
}

.product-body {
  padding: 16px;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.76rem;
  margin-bottom: 12px;
}

.product-name {
  display: block;
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 10px;
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
}

.product-footer strong {
  font-size: 1.1rem;
}

.product-footer button {
  background: rgba(250, 204, 21, 0.12);
  color: var(--yellow);
  border: 1px solid rgba(250, 204, 21, 0.2);
  border-radius: 12px;
  padding: 10px 12px;
}

.page-shell {
  padding: 36px 0 60px;
}

.catalog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 22px;
}

.search-input,
.auth-form input,
.checkout-form input,
.admin-form input,
.admin-form textarea,
.auth-card input {
  width: 100%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--text);
  padding: 12px 14px;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
}

.filter-chip {
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 10px 16px;
}

.filter-chip.active {
  background: rgba(250, 204, 21, 0.12);
  border-color: rgba(250, 204, 21, 0.3);
  color: var(--yellow);
}

.empty-state {
  display: grid;
  place-items: center;
  min-height: 180px;
  border: 1px dashed var(--line);
  border-radius: 18px;
  background: rgba(255,255,255,0.02);
  margin-top: 20px;
}

.empty-state.large {
  min-height: 280px;
  padding: 32px;
}

.product-page {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 28px;
}

.product-visual img {
  width: 100%;
  border-radius: 28px;
  min-height: 480px;
  object-fit: cover;
}

.product-price {
  font-size: 2rem;
  color: var(--yellow);
  font-weight: 700;
}

.rating-line {
  display: flex;
  gap: 18px;
  color: var(--muted);
  margin-bottom: 14px;
}

.product-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 22px;
}

.auth-shell,
.checkout-shell,
.account-shell,
.admin-shell {
  display: grid;
  gap: 24px;
}

.auth-card,
.checkout-card,
.card-box {
  background: #111111;
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 24px;
}

.auth-card {
  max-width: 560px;
  margin: 0 auto;
  width: 100%;
}

.auth-form,
.checkout-form,
.admin-form {
  display: grid;
  gap: 16px;
}

.auth-form label,
.checkout-form label,
.admin-form label {
  display: grid;
  gap: 8px;
  color: var(--muted);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.full-span {
  grid-column: 1 / -1;
}

.error-text {
  color: #fca5a5;
  margin: 0;
}

.center {
  margin: 0 auto;
}

.text-button {
  background: transparent;
  color: var(--yellow);
  padding: 0;
}

.checkout-shell {
  grid-template-columns: 1fr;
}

.order-total-box {
  display: grid;
  gap: 12px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  padding: 18px;
  border-radius: 18px;
}

.order-total-box > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.full-width {
  width: 100%;
}

.account-summary {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.orders-list,
.inventory-list {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.order-row,
.inventory-item {
  display: grid;
  grid-template-columns: 1.5fr auto auto;
  align-items: center;
  gap: 12px;
  background: rgba(255,255,255,0.02);
  border-radius: 14px;
  padding: 14px 16px;
  border: 1px solid var(--line);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(250, 204, 21, 0.12);
  color: var(--yellow);
  font-size: 0.75rem;
  text-transform: uppercase;
}

.inventory-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.checkbox-row {
  display: flex !important;
  align-items: center;
  gap: 10px;
}

.cart-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: flex-end;
  z-index: 30;
}

.cart-drawer {
  width: min(420px, 100vw);
  height: 100%;
  background: #0f0f0f;
  border-left: 1px solid var(--line);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-items {
  display: grid;
  gap: 14px;
  overflow: auto;
}

.cart-item {
  display: grid;
  grid-template-columns: 88px 1fr;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}

.cart-item img {
  width: 88px;
  height: 88px;
  object-fit: cover;
  border-radius: 12px;
}

.cart-item-body {
  display: grid;
  gap: 10px;
}

.cart-item h4 {
  margin: 0;
  font-size: 1rem;
}

.cart-controls {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.cart-controls button {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.04);
  color: var(--text);
}

.cart-summary {
  margin-top: auto;
  display: grid;
  gap: 12px;
  padding-top: 18px;
  border-top: 1px solid var(--line);
}

.cart-summary > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.total-row {
  font-size: 1.12rem;
}

.site-footer {
  border-top: 1px solid var(--line);
  background: rgba(255,255,255,0.02);
}

.footer-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 72px;
  color: var(--muted);
}

@media (max-width: 900px) {
  .hero-inner,
  .product-page,
  .category-grid,
  .product-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero-inner {
    grid-template-columns: 1fr;
  }

  .main-nav {
    display: none;
  }
}

@media (max-width: 640px) {
  .product-grid,
  .category-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .nav-shell,
  .header-actions,
  .catalog-header,
  .footer-shell,
  .order-row,
  .inventory-item {
    grid-template-columns: 1fr;
    flex-direction: column;
    align-items: stretch;
  }

  .nav-shell {
    display: flex;
    padding: 12px 0;
  }

  .header-actions {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .hero {
    padding-top: 30px;
  }

  .cart-item {
    grid-template-columns: 1fr;
  }
}
